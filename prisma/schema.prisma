generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  legalName            String?
  taxPin               String?
  currency             String                  @default("KES")
  country              String                  @default("KE")
  timezone             String                  @default("Africa/Nairobi")
  logoUrl              String?
  phone                String?
  email                String?
  address              String?
  businessType         String?
  settings             Json                    @default("{}")
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  auditLogs            AuditLog[]
  branches             Branch[]
  brands               Brand[]
  categories           Category[]
  customers            Customer[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  notificationSettings NotificationSetting[]
  paymentProviderCfgs  PaymentProviderConfig[]
  products             Product[]
  purchaseOrders       PurchaseOrder[]
  receiptSettings      ReceiptSettings?
  roles                Role[]
  sales                Sale[]
  stockCounts          StockCount[]
  stockTransfers       StockTransfer[]
  subscription         Subscription?
  suppliers            Supplier[]
  taxRates             TaxRate[]
  users                UserOrganization[]

  @@map("organizations")
}

model Branch {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashSessions   CashSession[]
  expenses       Expense[]
  purchaseOrders PurchaseOrder[]
  registers      Register[]
  sales          Sale[]
  transfersFrom  StockTransfer[] @relation("TransferFromBranch")
  transfersTo    StockTransfer[] @relation("TransferToBranch")
  userBranches   UserBranch[]
  warehouses     Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model Warehouse {
  id                 String              @id @default(cuid())
  organizationId     String
  branchId           String
  name               String
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  batches            Batch[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  stockCounts        StockCount[]
  transfersFrom      StockTransfer[]     @relation("TransferFromWarehouse")
  transfersTo        StockTransfer[]     @relation("TransferToWarehouse")
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@map("warehouses")
}

model Register {
  id           String        @id @default(cuid())
  branchId     String
  name         String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  cashSessions CashSession[]
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([branchId])
  @@map("registers")
}

model User {
  id                 String                   @id @default(cuid())
  name               String
  email              String                   @unique
  passwordHash       String
  phone              String?
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean                  @default(false)
  twoFactorSecret    String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  auditLogs          AuditLog[]
  cashSessions       CashSession[]            @relation("CashSessionUser")
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  salesCreated       Sale[]                   @relation("SaleCashier")
  sessions           Session[]
  branches           UserBranch[]
  organizations      UserOrganization[]

  @@map("users")
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  isOwner        Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  organizationId String?
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Role {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isSystem       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  permissions    RolePermission[]
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    UserOrganization[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  group String
  label String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryTree")
  products       Product[]

  @@index([organizationId])
  @@map("categories")
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@index([organizationId])
  @@map("brands")
}

model Product {
  id                String            @id @default(cuid())
  organizationId    String
  categoryId        String?
  brandId           String?
  primarySupplierId String?
  name              String
  description       String?
  type              ProductType       @default(STOCKED)
  unit              String            @default("pc")
  imageUrl          String?
  isActive          Boolean           @default(true)
  trackExpiry       Boolean           @default(false)
  trackSerial       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bundleItems       BundleItem[]      @relation("BundleParent")
  partOfBundles     BundleItem[]      @relation("BundleComponent")
  suppliers         ProductSupplier[]
  variants          ProductVariant[]
  brand             Brand?            @relation(fields: [brandId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primarySupplier   Supplier?         @relation(fields: [primarySupplierId], references: [id])

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  sku                String
  name               String
  attributes         Json                @default("{}")
  costPrice          Decimal             @db.Decimal(14, 2)
  sellingPrice       Decimal             @db.Decimal(14, 2)
  wholesalePrice     Decimal?            @db.Decimal(14, 2)
  taxRateId          String?
  minStock           Decimal             @default(0) @db.Decimal(14, 3)
  reorderLevel       Decimal             @default(0) @db.Decimal(14, 3)
  maxStock           Decimal?            @db.Decimal(14, 3)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  batches            Batch[]
  bundleComponentOf  BundleItem[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  barcodes           ProductBarcode[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRate            TaxRate?            @relation(fields: [taxRateId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductBarcode {
  id        String         @id @default(cuid())
  variantId String
  barcode   String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("product_barcodes")
}

model BundleItem {
  id                 String          @id @default(cuid())
  bundleProductId    String
  componentProductId String
  componentVariantId String?
  quantity           Decimal         @db.Decimal(14, 3)
  bundleProduct      Product         @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct   Product         @relation("BundleComponent", fields: [componentProductId], references: [id])
  componentVariant   ProductVariant? @relation(fields: [componentVariantId], references: [id])

  @@map("bundle_items")
}

model TaxRate {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  rate           Decimal          @db.Decimal(6, 3)
  isDefault      Boolean          @default(false)
  isActive       Boolean          @default(true)
  variants       ProductVariant[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tax_rates")
}

model Supplier {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  taxPin         String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  productLinks   ProductSupplier[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("suppliers")
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  supplierSku String?
  costPrice   Decimal? @db.Decimal(14, 2)
  isPreferred Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  organizationId       String
  branchId             String
  warehouseId          String
  supplierId           String
  poNumber             String
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal             @default(0) @db.Decimal(14, 2)
  discountTotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal             Decimal             @default(0) @db.Decimal(14, 2)
  total                Decimal             @default(0) @db.Decimal(14, 2)
  expectedDeliveryDate DateTime?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  goodsReceipts        GoodsReceipt[]
  items                PurchaseOrderItem[]
  branch               Branch              @relation(fields: [branchId], references: [id])
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id])
  invoices             SupplierInvoice[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Decimal            @db.Decimal(14, 3)
  quantityReceived Decimal            @default(0) @db.Decimal(14, 3)
  unitCost         Decimal            @db.Decimal(14, 2)
  discount         Decimal            @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal            @default(0) @db.Decimal(14, 2)
  total            Decimal            @db.Decimal(14, 2)
  receiptItems     GoodsReceiptItem[]
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant     @relation(fields: [variantId], references: [id])

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  purchaseOrderId String
  receivedById    String
  receivedAt      DateTime           @default(now())
  notes           String?
  items           GoodsReceiptItem[]
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  quantityReceived    Decimal           @db.Decimal(14, 3)
  batchNumber         String?
  expiryDate          DateTime?
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id              String            @id @default(cuid())
  organizationId  String
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String
  amount          Decimal           @db.Decimal(14, 2)
  amountPaid      Decimal           @default(0) @db.Decimal(14, 2)
  dueDate         DateTime?
  status          String            @default("UNPAID")
  createdAt       DateTime          @default(now())
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  payments        SupplierPayment[]

  @@index([organizationId, status])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id             String           @id @default(cuid())
  organizationId String
  supplierId     String
  invoiceId      String?
  amount         Decimal          @db.Decimal(14, 2)
  method         String
  reference      String?
  paidAt         DateTime         @default(now())
  createdById    String
  invoice        SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  supplier       Supplier         @relation(fields: [supplierId], references: [id])

  @@index([organizationId, supplierId])
  @@map("supplier_payments")
}

model InventoryItem {
  id          String         @id @default(cuid())
  warehouseId String
  variantId   String
  batchId     String?
  quantity    Decimal        @default(0) @db.Decimal(14, 3)
  averageCost Decimal        @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime       @updatedAt
  batch       Batch?         @relation(fields: [batchId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId, batchId])
  @@index([warehouseId])
  @@index([variantId])
  @@map("inventory_items")
}

model Batch {
  id             String              @id @default(cuid())
  warehouseId    String
  variantId      String
  batchNumber    String?
  unitCost       Decimal             @db.Decimal(14, 4)
  quantityIn     Decimal             @db.Decimal(14, 3)
  quantityLeft   Decimal             @db.Decimal(14, 3)
  expiryDate     DateTime?
  receivedAt     DateTime            @default(now())
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  movements      InventoryMovement[]

  @@index([warehouseId, variantId, receivedAt])
  @@map("batches")
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  warehouseId    String
  variantId      String
  batchId        String?
  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(14, 3)
  unitCost       Decimal?              @db.Decimal(14, 4)
  referenceType  String?
  referenceId    String?
  reason         String?
  createdById    String
  createdAt      DateTime              @default(now())
  batch          Batch?                @relation(fields: [batchId], references: [id])
  variant        ProductVariant        @relation(fields: [variantId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])

  @@index([organizationId, variantId, warehouseId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model StockTransfer {
  id              String              @id @default(cuid())
  organizationId  String
  fromBranchId    String
  toBranchId      String
  fromWarehouseId String
  toWarehouseId   String
  status          StockTransferStatus @default(DRAFT)
  createdById     String
  createdAt       DateTime            @default(now())
  items           StockTransferItem[]
  fromBranch      Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  fromWarehouse   Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toBranch        Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id])
  toWarehouse     Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])

  @@index([organizationId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  variantId       String
  quantity        Decimal       @db.Decimal(14, 3)
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model StockCount {
  id             String           @id @default(cuid())
  organizationId String
  warehouseId    String
  status         StockCountStatus @default(DRAFT)
  createdById    String
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  items          StockCountItem[]
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id])

  @@index([organizationId])
  @@map("stock_counts")
}

model StockCountItem {
  id              String     @id @default(cuid())
  stockCountId    String
  variantId       String
  systemQuantity  Decimal    @db.Decimal(14, 3)
  countedQuantity Decimal    @db.Decimal(14, 3)
  variance        Decimal    @db.Decimal(14, 3)
  stockCount      StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@map("stock_count_items")
}

model Customer {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  category       CustomerCategory  @default(NEW)
  creditLimit    Decimal           @default(0) @db.Decimal(14, 2)
  isWalkIn       Boolean           @default(false)
  notes          String?
  createdAt      DateTime          @default(now())
  payments       CustomerPayment[]
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleReturns    SaleReturn[]
  sales          Sale[]

  @@index([organizationId])
  @@map("customers")
}

model CustomerPayment {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  saleId         String?
  amount         Decimal  @db.Decimal(14, 2)
  method         String
  reference      String?
  receivedById   String
  paidAt         DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale           Sale?    @relation(fields: [saleId], references: [id])

  @@index([organizationId, customerId])
  @@map("customer_payments")
}

model CashSession {
  id                 String            @id @default(cuid())
  organizationId     String
  branchId           String
  registerId         String
  userId             String
  status             CashSessionStatus @default(OPEN)
  openingBalance     Decimal           @db.Decimal(14, 2)
  expectedBalance    Decimal?          @db.Decimal(14, 2)
  actualBalance      Decimal?          @db.Decimal(14, 2)
  variance           Decimal?          @db.Decimal(14, 2)
  openedAt           DateTime          @default(now())
  closedAt           DateTime?
  cashRemoved        Decimal?          @db.Decimal(14, 2)
  closingFloat       Decimal?          @db.Decimal(14, 2)
  closingNote        String?
  denominationCounts Json?
  varianceReason     String?
  movements          CashMovement[]
  branch             Branch            @relation(fields: [branchId], references: [id])
  register           Register          @relation(fields: [registerId], references: [id])
  user               User              @relation("CashSessionUser", fields: [userId], references: [id])
  sales              Sale[]

  @@index([organizationId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  type          CashMovementType
  amount        Decimal          @db.Decimal(14, 2)
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime         @default(now())
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@map("cash_movements")
}

model Sale {
  id               String            @id @default(cuid())
  organizationId   String
  branchId         String
  registerId       String
  cashSessionId    String?
  customerId       String?
  cashierId        String
  receiptNumber    String
  status           SaleStatus        @default(COMPLETED)
  subtotal         Decimal           @db.Decimal(14, 2)
  discountTotal    Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal           @default(0) @db.Decimal(14, 2)
  total            Decimal           @db.Decimal(14, 2)
  cogsTotal        Decimal           @default(0) @db.Decimal(14, 2)
  amountPaid       Decimal           @default(0) @db.Decimal(14, 2)
  changeGiven      Decimal           @default(0) @db.Decimal(14, 2)
  isCreditSale     Boolean           @default(false)
  voidedById       String?
  voidedAt         DateTime?
  voidReason       String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  customerPayments CustomerPayment[]
  payments         Payment[]
  items            SaleItem[]
  returns          SaleReturn[]
  branch           Branch            @relation(fields: [branchId], references: [id])
  cashSession      CashSession?      @relation(fields: [cashSessionId], references: [id])
  cashier          User              @relation("SaleCashier", fields: [cashierId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  register         Register          @relation(fields: [registerId], references: [id])

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, status])
  @@map("sales")
}

model SaleItem {
  id                  String           @id @default(cuid())
  saleId              String
  variantId           String
  quantity            Decimal          @db.Decimal(14, 3)
  unitPrice           Decimal          @db.Decimal(14, 2)
  discount            Decimal          @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal          @default(0) @db.Decimal(14, 2)
  unitCost            Decimal          @default(0) @db.Decimal(14, 4)
  total               Decimal          @db.Decimal(14, 2)
  productNameSnapshot String?
  variantNameSnapshot String?
  skuSnapshot         String?
  sale                Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant             ProductVariant   @relation(fields: [variantId], references: [id])
  returnItems         SaleReturnItem[]

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  saleId         String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(14, 2)
  status         PaymentStatus @default(CONFIRMED)
  providerRef    String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId, saleId])
  @@index([providerRef])
  @@map("payments")
}

model PaymentProviderConfig {
  id             String       @id @default(cuid())
  organizationId String
  provider       String
  isActive       Boolean      @default(false)
  config         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("payment_provider_configs")
}

model ReceiptSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  paperSize            String       @default("80mm")
  autoPrint            Boolean      @default(true)
  showBusinessLogo     Boolean      @default(true)
  showCashier          Boolean      @default(true)
  showCustomer         Boolean      @default(true)
  showSku              Boolean      @default(true)
  showTax              Boolean      @default(true)
  showDiscount         Boolean      @default(true)
  showPaymentReference Boolean      @default(true)
  footerMessage        String?
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("receipt_settings")
}

model NotificationSetting {
  id             String       @id @default(cuid())
  organizationId String
  eventKey       String
  dashboard      Boolean      @default(true)
  email          Boolean      @default(false)
  enabled        Boolean      @default(true)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventKey])
  @@index([organizationId])
  @@map("notification_settings")
}

model SaleReturn {
  id             String           @id @default(cuid())
  organizationId String
  saleId         String
  customerId     String?
  status         SaleReturnStatus @default(PENDING_APPROVAL)
  reason         String?
  refundMethod   String?
  refundAmount   Decimal          @default(0) @db.Decimal(14, 2)
  requestedById  String
  approvedById   String?
  createdAt      DateTime         @default(now())
  items          SaleReturnItem[]
  customer       Customer?        @relation(fields: [customerId], references: [id])
  sale           Sale             @relation(fields: [saleId], references: [id])

  @@index([organizationId, saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleItemId   String
  quantity     Decimal    @db.Decimal(14, 3)
  refundAmount Decimal    @db.Decimal(14, 2)
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@map("sale_return_items")
}

model ExpenseCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String?
  categoryId     String
  amount         Decimal         @db.Decimal(14, 2)
  paymentMethod  String
  description    String?
  attachmentUrl  String?
  createdById    String
  incurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  branch         Branch?         @relation(fields: [branchId], references: [id])
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, incurredAt])
  @@map("expenses")
}

model Subscription {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  plan             String
  status           String       @default("trialing")
  branchLimit      Int          @default(1)
  userLimit        Int          @default(5)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum ProductType {
  STOCKED
  SERVICE
  BUNDLE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryMovementType {
  OPENING_BALANCE
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  DAMAGE
  LOSS
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  STOCK_COUNT
  EXPIRY
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CustomerCategory {
  NEW
  REGULAR
  VIP
  INACTIVE
  CREDIT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SALE
  REFUND
  EXPENSE
  DEPOSIT
  WITHDRAWAL
  ADJUSTMENT
}

enum SaleStatus {
  HELD
  COMPLETED
  VOIDED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK_TRANSFER
  CREDIT
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum SaleReturnStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}
